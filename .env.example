# Spendwise Environment Variables

# Supabase (Required)
# Found in your Supabase project dashboard under Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic Claude API (Optional - features degrade gracefully to heuristic parser & fallback summary if omitted)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Application URL (for OAuth redirects and absolute URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
